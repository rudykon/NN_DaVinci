{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nn-davinci.local/schemas/project-1.4.schema.json",
  "title": "NN_DaVinci project schema 1.4",
  "type": "object",
  "required": ["project_version", "name", "graph", "figure_ir", "scene_ir"],
  "properties": {
    "project_version": { "const": "1.4" },
    "name": { "type": "string", "minLength": 1 },
    "graph": {
      "type": "object",
      "required": ["name", "nodes", "edges"],
      "properties": {
        "name": { "type": "string" },
        "nodes": { "type": "array" },
        "edges": { "type": "array" }
      },
      "additionalProperties": true
    },
    "figure_ir": {
      "oneOf": [
        { "$ref": "figure-ir-1.0.schema.json" },
        { "type": "object", "maxProperties": 0 }
      ]
    },
    "scene_ir": { "$ref": "scene-ir-1.0.schema.json" },
    "semantic_view": {
      "type": "object",
      "required": ["version", "level", "view"],
      "properties": {
        "version": { "const": "1.0" },
        "level": {
          "type": ["string", "null"],
          "enum": [null, "framework", "model", "stage", "block", "module", "layer", "operation", "template"]
        },
        "view": { "enum": ["faithful", "paper"] },
        "document": {
          "type": "object",
          "required": [
            "name", "source_ir_version", "source_digest", "entities", "connections",
            "source_to_semantic", "semantic_to_source", "detections", "semantic_version"
          ],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "source_ir_version": { "type": "string", "minLength": 1 },
            "source_digest": { "type": "string", "minLength": 1 },
            "entities": { "type": "array", "minItems": 1 },
            "connections": { "type": "object" },
            "source_to_semantic": { "type": "object" },
            "semantic_to_source": { "type": "object" },
            "detections": { "type": "array" },
            "semantic_version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "environment": { "type": "object" },
    "canvas_state": { "type": "object" },
    "figure_composer": { "type": "object" }
  },
  "additionalProperties": true
}
